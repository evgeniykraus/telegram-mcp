{
    "mcpServers": {
        "laravel-boost": {
            "command": "vendor/bin/sail",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "postiz-analytics": {
            "command": "vendor/bin/sail",
            "args": [
                "artisan",
                "mcp:start",
                "analytics"
            ]
        }
    }
}